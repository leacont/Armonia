<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_open_sales_report_list" model="ir.ui.view">
        <field name="name">open.sales.report.list</field>
        <field name="model">open.sales.report</field>
        <field name="arch" type="xml">
            <list string="Open Sales Order Report" create="0" edit="0" delete="0">
                <field name="date_order"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty" sum="Total Ordered Qty"/>
                <field name="qty_delivered"   sum="Total Delivered Qty"/>
                <field name="qty_pending" class="text-danger" sum="Total Pending Qty"/>
                <field name="price_unit"/>
                <field name="amount_pending"  sum="Total Pending Amount"/>
                <field name="currency_id"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_open_sales_report_form" model="ir.ui.view">
        <field name="name">open.sales.report.form</field>
        <field name="model">open.sales.report</field>
        <field name="arch" type="xml">
            <form string="Open Sales Order Report" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="date_order"/>
                        <field name="sale_order_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="product_id"/>
                        <field name="product_uom_qty"/>
                        <field name="qty_delivered"/>
                        <field name="qty_pending"/>
                        <field name="price_unit"/>
                        <field name="amount_pending"/>
                        <field name="currency_id"/>
                        <field name="product_uom_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_open_sales_report_search" model="ir.ui.view">
        <field name="name">open.sales.report.search</field>
        <field name="model">open.sales.report</field>
        <field name="arch" type="xml">
            <search string="Open Sales Order Report">
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="date_order"/>
                <separator/>
                <filter string="Order date" name="filter_date_order" date="date_order"/>
                <group>
                    <filter name="group_by_day" string="Day" context="{'group_by': 'date_order:day'}"/>
                    <filter name="group_by_week" string="Week" context="{'group_by': 'date_order:week'}"/>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'date_order:month'}"/>
                    <filter name="group_by_year" string="Year" context="{'group_by': 'date_order:year'}"/>
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
                <searchpanel view_types="list,pivot,graph">
                    <field name="partner_id" string="Customer" icon="fa-users" select="multi" enable_counters="1"/>
                    <field name="product_id" string="Product" icon="fa-cube" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Graph view -->
    <record id="view_open_sales_report_graph" model="ir.ui.view">
        <field name="name">open.sales.report.graph</field>
        <field name="model">open.sales.report</field>
        <field name="arch" type="xml">
            <graph string="Open Sales Order Report" type="bar">
                <field name="date_order" type="row"/>
                <field name="qty_pending" type="measure"/>
                <field name="amount_pending" type="measure"/>
                <field name="product_id"/>
                <field name="partner_id"/>
            </graph>
        </field>
    </record>

    <!-- Pivot view -->
    <record id="view_open_sales_report_pivot" model="ir.ui.view">
        <field name="name">open.sales.report.pivot</field>
        <field name="model">open.sales.report</field>
        <field name="arch" type="xml">
            <pivot string="Open Sales Order Report">
                <field name="product_id" type="row"/>
                <field name="partner_id" type="col"/>
                <field name="qty_pending" type="measure"/>
                <field name="amount_pending" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="action_open_sales_report" model="ir.actions.act_window">
        <field name="name">Open Sales Order Report</field>
        <field name="res_model">open.sales.report</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_open_sales_report_search"/>
        <field name="context">{'graph_measure': 'qty_pending'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open Sales Order Report</p>
            <p>Confirmed sales order lines with quantity still to deliver (read-only report).</p>
        </field>
    </record>

    <!-- MenuItem -->
    <menuitem
        id="menu_open_sales_report"
        name="Open Sales Order Report"
        parent="sale.sale_menu_root"
        action="action_open_sales_report"
        sequence="80"
        groups="stock.group_stock_user"
    />
</odoo>
