<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mrp_planning_wc_micro_wizard_form" model="ir.ui.view">
    <field name="name">mrp.planning.wc.micro.wizard.form</field>
    <field name="model">mrp.planning.wc.micro.wizard</field>
    <field name="arch" type="xml">
      <form string="Micro planning by work center">
        <group>
          <field name="workcenter_id" options="{'no_create': True}"/>
        </group>
        <footer>
          <button name="action_open_micro_planner" type="object" string="Open micro planner" class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_mrp_planning_wc_micro_wizard" model="ir.actions.act_window">
    <field name="name">Micro planning by work center</field>
    <field name="res_model">mrp.planning.wc.micro.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
